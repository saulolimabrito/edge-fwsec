delete table ip efw_nat

table inet efw_filter {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state vmap { established : accept, related : accept, invalid : drop }
		iifname "lo" accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept comment "efw:icmpv6-errors"
		icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } ip6 hoplimit 255 accept comment "efw:icmpv6-nd"
		icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } ip6 saddr fe80::/10 accept comment "efw:icmpv6-mld"
		iifname "mgmt0" tcp dport 443 accept comment "efw:admin"
		iifname "lan0" meta l4proto icmp counter accept comment "efw:rule:lan-ping-fw"
		iifname "lan0" meta l4proto ipv6-icmp counter accept comment "efw:rule:lan-ping-fw"
		limit rate 10/second burst 20 packets log prefix "efw default input " comment "efw:default-log"
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state vmap { established : accept, related : accept, invalid : drop }
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem } accept comment "efw:icmpv6-errors"
		iifname "wan0" ip daddr 192.168.10.10 tcp dport 80 ct status dnat counter accept comment "efw:pf:web-in"
		iifname "lan0.30" oifname "lan0" counter log prefix "efw guest-no-lan " reject with icmpx admin-prohibited comment "efw:rule:guest-no-lan"
		iifname "lan0" oifname "wan0" ip saddr 192.168.10.0/24 counter accept comment "efw:rule:lan-out"
		iifname "lan0" oifname "wan0" ip6 saddr 2001:db8:10::/64 counter accept comment "efw:rule:lan-out"
		iifname "lan0.30" oifname "wan0" tcp dport { 80, 443 } counter accept comment "efw:rule:guest-web-out"
		iifname "lan0.30" oifname "wan0" udp dport 53 counter accept comment "efw:rule:guest-dns-out"
		iifname "lan0.30" oifname "wan0" tcp dport 53 counter accept comment "efw:rule:guest-dns-out"
		iifname "wan0" oifname "lan0" ip6 daddr 2001:db8:10::10 tcp dport { 80, 443 } counter accept comment "efw:rule:web6-in"
		limit rate 10/second burst 20 packets log prefix "efw default forward " comment "efw:default-log"
	}
}

table ip efw_nat {
	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
		iifname "wan0" tcp dport 8080 counter dnat to 192.168.10.10:80 comment "efw:pf:web-in"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "wan0" ip saddr 192.168.0.0/16 counter masquerade comment "efw:snat:lan-masq"
	}
}
