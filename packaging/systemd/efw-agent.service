[Unit]
Description=Edge FWSec policy agent (applies firewall and network revisions)
Documentation=https://github.com/saulolimabrito/edge-fwsec/blob/main/docs/architecture.md
Wants=NetworkManager.service
After=dbus.service NetworkManager.service systemd-tmpfiles-setup.service
Before=network-online.target efw-web.service
# The agent replaces firewalld as the owner of the host firewall.
Conflicts=firewalld.service

[Service]
Type=notify
ExecStart=/usr/bin/efw-agent -state-dir /var/lib/efw -socket /run/efw/agent.sock -socket-group efw
Restart=on-failure
RestartSec=2s
TimeoutStartSec=90s
# SIGTERM rolls back a revision under test before exiting.
TimeoutStopSec=60s
UMask=0077

StateDirectory=efw
StateDirectoryMode=0700
ReadWritePaths=/run/efw

# Root is needed for nftables (CAP_NET_ADMIN) and the NetworkManager D-Bus
# API; everything else is taken away.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
